# Copia in .env (mai committato). Valori solo per sviluppo locale.

# --- Django / API
DJANGO_SETTINGS_MODULE=safe.settings.dev
SECRET_KEY=dev-only-change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,api
PUBLIC_WEB_URL=http://localhost:4200
PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Database (PostGIS). Ruoli creati da infra/db/init.sql: safe_owner (app, soggetto a RLS),
#     safe_admin (bypass RLS, solo comandi di piattaforma). Il superuser postgres non è mai usato dall'app.
POSTGRES_SUPERUSER_PASSWORD=postgres
DATABASE_URL=postgis://safe_owner:safe@db:5432/safe

# --- Redis (cache, broker Celery, channel layer)
REDIS_URL=redis://redis:6379/0

# --- OIDC (Keycloak)
# issuer come appare nel claim `iss` dei token (hostname pubblico di Keycloak)
OIDC_ISSUER=http://localhost:8080/realms/safe
# JWKS raggiunto dall'API sulla rete interna di Compose
OIDC_JWKS_URL=http://keycloak:8080/realms/safe/protocol/openid-connect/certs
OIDC_AUDIENCE=safe-api
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_ADMIN_CLIENT_ID=safe-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-admin-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Object storage (MinIO in sviluppo, S3 compatibile in produzione)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=safe
S3_SECRET_KEY=safe-secret
S3_BUCKET=safe-files
S3_REGION=eu-central-1

# --- Email (Mailpit in sviluppo)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=safe@localhost

# --- Cartografia (Mapbox). Il token pubblico pk.* va in frontend/public/config/app-config.json (mapboxToken).
MAPBOX_STYLE_WINTER=mapbox://styles/mapbox/light-v11
MAPBOX_STYLE_SUMMER=mapbox://styles/mapbox/outdoors-v12
MAPBOX_STYLE_SATELLITE=mapbox://styles/mapbox/satellite-streets-v12
# token segreto sk.* solo server, per le immagini statiche dei PDF (M5)
MAPBOX_SECRET_TOKEN=
# in alternativa il token pubblico, sufficiente per le immagini statiche
MAPBOX_TOKEN=

# --- Osservabilità
SENTRY_DSN=
LOG_LEVEL=INFO
