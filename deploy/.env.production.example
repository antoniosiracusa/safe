# SAFE · variabili di produzione. Copia in /opt/safe/.env sul server (mai in git).
# Sostituisci "safe.esempio.it" con il dominio reale in TUTTE le righe in cui compare
# (Compose non espande riferimenti annidati) e genera i segreti con:  openssl rand -base64 36

# --- Dominio e certificati ---------------------------------------------------------------
DOMAIN=safe.esempio.it
ACME_EMAIL=it@esempio.it
# titolo della pagina di accesso (Keycloak)
REALM_DISPLAY_NAME=SAFE
# Logo nell'intestazione del portale al posto del simbolo "S" (file in deploy/keycloak/themes/safe/login/resources/img,
# servito come /brand/<file>); vuoto = simbolo predefinito. BRAND_NAME sostituisce la scritta "SAFE" (vuoto = SAFE).
BRAND_LOGO_URL=brand/ski-civetta.png
BRAND_NAME=

# --- Immagini (CI → GHCR). Fissa un tag di versione per i rilasci controllati (deploy.sh vX.Y.Z).
API_IMAGE=ghcr.io/antoniosiracusa/safe-api:latest
WEB_IMAGE=ghcr.io/antoniosiracusa/safe-web:latest

# --- Django / API ----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=safe.settings.prod
SECRET_KEY=CHANGE-ME
DEBUG=0
# includere anche beta.DOMINIO se si attiva il canale beta (COMPOSE_PROFILES=beta)
ALLOWED_HOSTS=safe.esempio.it,api
# canale beta (M8): interfaccia di prova su https://beta.DOMINIO con la stessa API e gli stessi dati.
# Richiede: record DNS A per beta.DOMINIO, ALLOWED_HOSTS con beta.DOMINIO, redirect URI https://beta.DOMINIO/*
# e web origin nel client Keycloak safe-web. Vuoto = beta disattiva.
COMPOSE_PROFILES=
PUBLIC_WEB_URL=https://safe.esempio.it
PUBLIC_API_URL=https://safe.esempio.it/api/v1
CORS_ALLOWED_ORIGINS=https://safe.esempio.it
LOG_LEVEL=INFO

# --- Database (le password vengono usate da db/init.prod.sh alla prima inizializzazione) --------
POSTGRES_SUPERUSER_PASSWORD=CHANGE-ME
SAFE_DB_PASSWORD=CHANGE-ME
KEYCLOAK_DB_PASSWORD=CHANGE-ME
# stessa password di SAFE_DB_PASSWORD
DATABASE_URL=postgis://safe_owner:CHANGE-ME@db:5432/safe

# --- Redis --------------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Keycloak (issuer pubblico; JWKS e Admin API sulla rete interna) ------------------------------
OIDC_ISSUER=https://auth.safe.esempio.it/realms/safe
OIDC_JWKS_URL=http://keycloak:8080/realms/safe/protocol/openid-connect/certs
OIDC_AUDIENCE=safe-api
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_REALM=safe
KEYCLOAK_ADMIN_CLIENT_ID=safe-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE-ME
KEYCLOAK_WEB_CLIENT_ID=safe-web
# console di amministrazione Keycloak (https://auth.<dominio>/admin/)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE-ME

# --- Posta in uscita (Keycloak: inviti, reset password, OTP; realm generato da render.sh) -----------
SMTP_HOST=smtp.esempio.it
SMTP_PORT=587
SMTP_USER=safe@esempio.it
SMTP_PASSWORD=CHANGE-ME
SMTP_FROM=safe@esempio.it
SMTP_FROM_NAME=SAFE
SMTP_STARTTLS=true
SMTP_SSL=false
# Django (notifiche future): stessi valori
EMAIL_HOST=smtp.esempio.it
EMAIL_PORT=587
EMAIL_HOST_USER=safe@esempio.it
EMAIL_HOST_PASSWORD=CHANGE-ME
EMAIL_USE_TLS=true
# porta 465 (es. smtps.aruba.it): EMAIL_USE_TLS=false e EMAIL_USE_SSL=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=safe@esempio.it

# --- Object storage (MinIO locale; per Aruba Object Storage: endpoint https e chiavi del bucket) -------
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=safe
S3_SECRET_KEY=CHANGE-ME
S3_BUCKET=safe-files
S3_REGION=eu-central-1

# --- Cartografia (Mapbox) -------------------------------------------------------------------------
# token pubblico pk.* (limitato al dominio nel pannello Mapbox): SPA e immagini statiche dei PDF
MAPBOX_PUBLIC_TOKEN=pk.CHANGE-ME
MAPBOX_TOKEN=pk.CHANGE-ME
MAPBOX_SECRET_TOKEN=
MAPBOX_STYLE_WINTER=mapbox://styles/mapbox/light-v11
MAPBOX_STYLE_SUMMER=mapbox://styles/mapbox/outdoors-v12
MAPBOX_STYLE_SATELLITE=mapbox://styles/mapbox/satellite-streets-v12
# centro iniziale della mappa: longitudine,latitudine
MAP_DEFAULT_CENTER=12.1,46.45
MAP_DEFAULT_ZOOM=11

# --- Backup (backup.sh): cifratura simmetrica + copia su S3 esterno (opzionale) ------------------------
BACKUP_PASSPHRASE=CHANGE-ME
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_KEEP_DAYS=30
# destinatario degli avvisi di monitor.sh (disco, container, API, backup) e del riepilogo settimanale
ALERT_EMAIL=admin@esempio.it
ALERT_DISK_PERCENT=80
# giorni di conservazione sul bucket esterno (0 = mai rimuovere)
BACKUP_S3_KEEP_DAYS=90

# --- Osservabilità -------------------------------------------------------------------------------------
SENTRY_DSN=
